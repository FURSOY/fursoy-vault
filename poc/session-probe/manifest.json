{
  "manifest_version": 3,
  "name": "FURSOY Session and Duty-cycle Probe",
  "version": "0.2.0",
  "description": "Measures synthetic session eviction/restoration and cookie exposure duty cycle.",
  "key": "",
  "permissions": ["alarms", "cookies", "idle", "storage", "tabs"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "action": {
    "default_title": "Open duty-cycle probe"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:43118/*", "http://127.0.0.1:43118/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}

{
  "manifest_version": 3,
  "name": "FURSOY Cookie Attribute Probe",
  "version": "0.1.0",
  "description": "Tests chrome.cookies attribute round-trip behavior using synthetic probe cookies only.",
  "key": "",
  "permissions": ["cookies"],
  "host_permissions": [
    "http://localhost:43117/*",
    "https://localhost:43117/*"
  ],
  "action": {
    "default_title": "Open cookie attribute probe"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  }
}

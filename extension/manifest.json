{
  "manifest_version": 3,
  "name": "FURSOY Vault",
  "version": "0.3.1",
  "description": "FURSOY Vault with multi-group protection and redacted user-mode monitoring.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "cookies",
    "idle",
    "storage",
    "tabs",
    "alarms",
    "webNavigation",
    "notifications"
  ],
  "host_permissions": [
    "*://wikipedia.org/*",
    "*://*.wikipedia.org/*",
    "*://localhost/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "FURSOY Vault",
    "default_popup": "popup.html"
  },
  "optional_host_permissions": [
    "*://*/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}

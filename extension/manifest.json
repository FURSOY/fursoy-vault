{
  "manifest_version": 3,
  "name": "FURSOY Cookie Protector MVP",
  "version": "0.1.12",
  "description": "Single Wikipedia account-group MVP with a navigation unlock gate prototype.",
  "key": "",
  "permissions": ["nativeMessaging", "cookies", "idle", "storage", "tabs", "scripting", "alarms", "webNavigation"],
  "host_permissions": ["https://tr.wikipedia.org/*", "https://wikipedia.org/*", "https://*.wikipedia.org/*"],
  "background": { "service_worker": "dist/background.js", "type": "module" },
  "action": { "default_title": "FURSOY MVP status" }
}

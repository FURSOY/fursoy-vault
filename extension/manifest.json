{
  "manifest_version": 3,
  "minimum_chrome_version": "130",
  "name": "FURSOY Vault",
  "version": "0.6.0",
  "description": "Malware doesn't need your password. It needs the cookies in your browser. Lock them away until your face or PIN opens them.",
  "icons": {
    "16": "assets/fursoy-vault-extension-icon.png",
    "32": "assets/fursoy-vault-extension-icon.png",
    "48": "assets/fursoy-vault-extension-icon.png",
    "128": "assets/fursoy-vault-extension-icon.png"
  },
  "key": "",
  "permissions": [
    "nativeMessaging",
    "cookies",
    "idle",
    "storage",
    "activeTab",
    "alarms",
    "webNavigation",
    "notifications"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "FURSOY Vault",
    "default_popup": "popup.html",
    "default_icon": "assets/fursoy-vault-extension-icon.png"
  },
  "optional_host_permissions": [
    "*://*/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
